// 變數定義 - 方便後續微調精密參數
$container-width: 900px;
$container-height: 400px;
$transition-speed: 0.6s;
$transition-easing: cubic-bezier(0.25, 1, 0.5, 1); // 流暢曲線

.accordion-container {
display: flex;
width: 100%;
max-width: $container-width;
height: $container-height;
margin: 2rem auto;
border-radius: 12px;
overflow: hidden; // 確保整體的圓角不會被內部圖片刺破
box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);

.card {
position: relative;
flex: 1; // 預設 1:1:1 均分寬度
height: 100%;
overflow: hidden; // 精髓：隱藏圖片不合身的部分
cursor: pointer;

// 預暢動態宣告
transition: flex #{$transition-speed} #{$transition-easing};

img {
width: 100%;
height: 100%;
object-fit: cover; // 確保圖片在比例變動時不變形
object-position: center;
transition: transform #{$transition-speed} #{$transition-easing};
}

// 遮罩與文字（選配，增添視覺層次）
.content {
position: absolute;
bottom: 0;
left: 0;
width: 100%;
padding: 20px;
background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
color: #ffffff;
font-size: 1.2rem;
opacity: 0;
transform: translateY(10px);
transition: all 0.4s ease;
}

// --- 關鍵動態：滑鼠懸停狀態 ---
&:hover {
flex: 3; // 放大自己，自然會把旁邊的卡片推擠過去

img {
transform: scale(1.05); // 圖片微微放大，增加沉浸感
}

.content {
opacity: 1;
transform: translateY(0);
transition-delay: 0.15s; // 稍微延遲讓文字在卡片展開後優雅出現
}}}}

